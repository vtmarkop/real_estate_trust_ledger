POSTGRES_DB=trustledger
POSTGRES_USER=trustledger
POSTGRES_PASSWORD=change-me-before-staging

TRUST_LEDGER_ENVIRONMENT=staging
TRUST_LEDGER_SECRET_KEY=change-me-before-staging
TRUST_LEDGER_DATABASE_URL=postgresql+psycopg://trustledger:change-me-before-staging@postgres:5432/trustledger
TRUST_LEDGER_PUBLIC_API_BASE_URL=http://localhost:8000
TRUST_LEDGER_PUBLIC_WEB_BASE_URL=http://localhost:8080
TRUST_LEDGER_ARTIFACT_STORAGE_BACKEND=local_private
TRUST_LEDGER_ARTIFACT_STORAGE_ROOT=/workspace/apps/api/private_artifacts
TRUST_LEDGER_REDIS_URL=redis://redis:6379/0
TRUST_LEDGER_WORKER_COORDINATION_BACKEND=redis
TRUST_LEDGER_NOTIFICATION_TRANSPORT=log
TRUST_LEDGER_COOKIE_SECURE=false
TRUST_LEDGER_CORS_ORIGINS=http://localhost:8080

VITE_TRUST_LEDGER_API_BASE_URL=http://localhost:8000/api/v1
